---
/**
 * Botón flotante de WhatsApp, presente en todas las páginas.
 * El mensaje se puede personalizar por página (ej.: con el nombre del modelo).
 * Se oculta mientras el menú de celular está abierto (html[data-menu-abierto]).
 */
import { sitio, enlaceWhatsApp } from '../lib/sitio';

interface Props {
  /** Mensaje prellenado. Por defecto, el general de sitio.json. */
  mensaje?: string;
}

const { mensaje } = Astro.props;
const href = enlaceWhatsApp(mensaje || sitio.whatsapp.mensaje);
---

<a class="flotante" href={href} rel="noopener" aria-label="Escribirnos por WhatsApp">
  <svg class="flotante__icono" viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M12 2.4A9.6 9.6 0 0 0 3.7 16.9L2.6 21l4.2-1.1A9.6 9.6 0 1 0 12 2.4Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"></path>
    <path
      d="M8.9 7.9c-.4.6-.5 1.4-.1 2.3.7 1.7 2.3 3.3 4 4 .9.4 1.7.3 2.3-.1l.5-.4-1.7-1.5-1 .6c-.7-.4-1.6-1.3-2-2l.6-1-1.5-1.7-.5.5Z"
      fill="currentColor"></path>
  </svg>
  <span class="flotante__texto">WhatsApp</span>
</a>

<style>
  .flotante {
    position: fixed;
    right: var(--margen-lateral);
    bottom: var(--margen-lateral);
    z-index: var(--capa-flotante);
    display: inline-flex;
    align-items: center;
    gap: var(--espacio-2);
    min-height: var(--tamano-flotante);
    padding-inline: var(--espacio-4);
    background-color: var(--color-whatsapp);
    color: #ffffff;
    border-radius: var(--radio-pildora);
    box-shadow: var(--sombra-lg);
    font-family: var(--fuente-titulos);
    font-size: var(--texto-sm);
    font-weight: var(--peso-medio);
    text-decoration: none;
    transition:
      background-color var(--transicion-rapida),
      transform var(--transicion-rapida),
      opacity var(--transicion-rapida);
  }

  .flotante:hover {
    background-color: var(--color-whatsapp-hover);
    transform: translateY(-2px);
  }

  .flotante__icono {
    width: var(--tamano-icono);
    height: var(--tamano-icono);
    flex-shrink: 0;
  }

  /* Celular: solo el icono, en círculo, para no tapar contenido */
  @media (max-width: 39.99em) {
    .flotante {
      width: var(--tamano-flotante);
      padding-inline: 0;
      justify-content: center;
    }

    .flotante__texto {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  /* Con el menú de celular abierto, el botón estorba */
  :global(html[data-menu-abierto]) .flotante {
    opacity: 0;
    pointer-events: none;
  }
</style>
