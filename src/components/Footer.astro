---
/**
 * Pie de página: marca, navegación, contacto y datos legales.
 * Los datos que todavía dicen "[COMPLETAR]" en sitio.json no se muestran,
 * salvo la razón social y el CUIT, que son obligatorios y quedan visibles
 * como recordatorio hasta que se carguen.
 */
import { sitio, dato, navegacion, lineas, rutaLinea, enlaceWhatsApp } from '../lib/sitio';

const anio = new Date().getFullYear();

const email = dato(sitio.email);
const direccion = dato(sitio.direccion);
const maps = dato(sitio.googleMaps);
const razonSocial = sitio.razonSocial;
const cuit = sitio.cuit;
---

<footer class="pie">
  <div class="contenedor pie__grilla">
    <div class="pie__marca">
      <img class="pie__logo" src="/logo.png" alt="Smart Panel Constructora" width="320" height="440" loading="lazy" />
      <p class="pie__bajada">
        Casas en construcción en seco (Wood Frame): obra gris con terminación exterior, llave en
        mano y obras a medida.
      </p>
      <p class="pie__zonas">Trabajamos en todo el país, con base en Córdoba y Gran Buenos Aires.</p>
    </div>

    <nav class="pie__columna" aria-label="Secciones">
      <h2 class="pie__titulo">Secciones</h2>
      <ul class="pie__lista" role="list">
        {
          navegacion.map((item) => (
            <li>
              <a href={item.href}>{item.texto}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="pie__columna" aria-label="Líneas de modelos">
      <h2 class="pie__titulo">Modelos</h2>
      <ul class="pie__lista" role="list">
        {
          lineas.map((linea) => (
            <li>
              <a href={rutaLinea(linea.slug)}>{linea.texto}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="pie__columna">
      <h2 class="pie__titulo">Contacto</h2>
      <ul class="pie__lista pie__lista--contacto" role="list">
        <li>
          <a class="pie__wa" href={enlaceWhatsApp()} rel="noopener">{sitio.whatsapp.visible}</a>
        </li>
        {
          email && (
            <li>
              <a href={`mailto:${email}`}>{email}</a>
            </li>
          )
        }
        {
          direccion && (
            <li>
              {maps ? (
                <a href={maps} rel="noopener">
                  {direccion}
                </a>
              ) : (
                <span>{direccion}</span>
              )}
            </li>
          )
        }
        <li class="texto-suave">{sitio.horario}</li>
      </ul>

      <!-- Redes: iconos con nombre accesible para lectores de pantalla -->
      <ul class="pie__redes" role="list">
        <li>
          <a href={enlaceWhatsApp()} rel="noopener" aria-label={`WhatsApp ${sitio.whatsapp.visible}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 2.4A9.6 9.6 0 0 0 3.7 16.9L2.6 21l4.2-1.1A9.6 9.6 0 1 0 12 2.4Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linejoin="round"></path>
              <path
                d="M8.9 7.9c-.4.6-.5 1.4-.1 2.3.7 1.7 2.3 3.3 4 4 .9.4 1.7.3 2.3-.1l.5-.4-1.7-1.5-1 .6c-.7-.4-1.6-1.3-2-2l.6-1-1.5-1.7-.5.5Z"
                fill="currentColor"></path>
            </svg>
          </a>
        </li>
        <li>
          <a href={sitio.instagram.url} rel="noopener me" aria-label={`Instagram @${sitio.instagram.usuario}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M4 8.5h3.2l1.3-2h7l1.3 2H20a1 1 0 0 1 1 1V18a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.500a1 1 0 0 1 1-1Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linejoin="round"></path>
              <circle cx="12" cy="13.500" r="3.200" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
            </svg>
          </a>
        </li>
        {
          sitio.facebook?.url && (
            <li>
              <a href={sitio.facebook.url} rel="noopener me" aria-label="Facebook de Smart Panel">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M7.5 20H5a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h2.500m0 9V11m0 9h8.700a2 2 0 0 0 2-1.600l1.100-5.500A1.600 1.600 0 0 0 17.700 11H14V7.200A2.200 2.200 0 0 0 11.800 5L7.500 11"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linejoin="round"
                    stroke-linecap="round"></path>
                </svg>
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>

  <div class="contenedor pie__legal">
    <p>
      © {anio} {razonSocial} · CUIT {cuit}
    </p>
    <p><a href="/privacidad/">Política de privacidad</a></p>
  </div>
</footer>

<style>
  .pie {
    background-color: var(--color-oscuro);
    color: var(--color-inverso);
    padding-block: var(--espacio-7) var(--espacio-5);
    border-top: var(--borde-fino) solid var(--color-borde);
  }

  .pie__grilla {
    display: grid;
    gap: var(--espacio-6);
  }

  /* ---------- Marca ---------- */
  .pie__nombre {
    font-family: var(--fuente-titulos);
    font-size: var(--texto-lg);
    font-weight: var(--peso-fuerte);
    line-height: 1.1;
  }

  .pie__nombre span {
    display: block;
    font-size: var(--texto-xs);
    font-weight: var(--peso-medio);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-inverso-suave);
    margin-top: var(--espacio-1);
  }

  .pie__bajada,
  .pie__zonas {
    max-width: 38ch;
    margin-top: var(--espacio-3);
    font-size: var(--texto-sm);
    color: var(--color-inverso-suave);
  }

  /* ---------- Columnas ---------- */
  .pie__titulo {
    font-size: var(--texto-xs);
    font-weight: var(--peso-medio);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-inverso-suave);
    margin-bottom: var(--espacio-3);
  }

  .pie__lista {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-1);
    padding: 0;
    list-style: none;
    font-size: var(--texto-sm);
  }

  .pie__lista--contacto {
    gap: var(--espacio-2);
  }

  .pie :is(.pie__lista, .pie__legal) a {
    display: block;
    /* Alto táctil de 44px sin flex, para que un email largo pueda partirse */
    padding-block: 0.6rem;
    overflow-wrap: anywhere;
    color: var(--color-inverso);
    text-decoration: none;
  }

  .pie :is(.pie__lista, .pie__legal) a:hover {
    text-decoration: underline;
  }

  .pie__lista .texto-suave {
    color: var(--color-inverso-suave);
  }

  .pie__wa {
    font-family: var(--fuente-titulos);
    font-size: var(--texto-md);
    font-weight: var(--peso-fuerte);
  }

  .pie__logo {
    width: auto;
    height: 5.5rem;
  }

  /* ---------- Iconos de redes ---------- */
  .pie__redes {
    display: flex;
    gap: var(--espacio-3);
    margin-top: var(--espacio-4);
    padding: 0;
    list-style: none;
  }

  .pie__redes a {
    display: grid;
    place-items: center;
    width: var(--tamano-tactil);
    height: var(--tamano-tactil);
    border: var(--borde-fino) solid var(--color-borde-fuerte);
    border-radius: var(--radio-pildora);
    color: var(--color-inverso);
    transition:
      background-color var(--transicion-rapida),
      border-color var(--transicion-rapida),
      color var(--transicion-rapida),
      transform var(--transicion-media);
  }

  .pie__redes a:hover {
    background-color: var(--blanco);
    border-color: var(--blanco);
    color: var(--marca-950);
    transform: translateY(-2px);
  }

  .pie__redes svg {
    width: var(--tamano-icono);
    height: var(--tamano-icono);
  }

  /* ---------- Barra legal ---------- */
  .pie__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--espacio-2);
    margin-top: var(--espacio-6);
    padding-top: var(--espacio-4);
    border-top: var(--borde-fino) solid rgb(255 255 255 / 0.14);
    font-size: var(--texto-xs);
    color: var(--color-inverso-suave);
  }

  .pie__legal a {
    font-size: var(--texto-xs);
    color: var(--color-inverso-suave);
  }

  /* ---------- Tablet y escritorio ---------- */
  @media (min-width: 40em) {
    .pie__grilla {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64em) {
    .pie__grilla {
      grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
      gap: var(--espacio-7);
    }
  }
</style>
